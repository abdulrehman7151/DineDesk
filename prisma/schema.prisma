generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int              @id @default(autoincrement())
  name          String
  email         String           @unique
  password      String
  phone         String?
  emailVerified Boolean          @default(true)
  createdAt     DateTime         @default(now())
  restaurants   Restaurant[]     @relation("RestaurantOwner")
  memberships   RestaurantUser[]
}

model Restaurant {
  id        Int              @id @default(autoincrement())
  name      String
  slug      String           @unique
  city      String
  address   String
  phone     String
  openingTime String?
  closingTime String?
  // Minutes after an order is served with no new items before it closes
  // itself and frees the table. Editable in admin Settings.
  servedAutoCloseMinutes Int @default(30)
  createdAt DateTime         @default(now())
  ownerId   Int
  owner     User             @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  users     RestaurantUser[]
  menuItems MenuItem[]
  tables    Table[]
  orders    Order[] // ← add this
  subscriptions Subscription[]

  @@index([ownerId], map: "Restaurant_ownerId_fkey")
}

model RestaurantUser {
  id           Int        @id @default(autoincrement())
  userId       Int
  restaurantId Int
  isActive     Boolean    @default(true)
  role         String     @default("chef")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId], map: "RestaurantUser_restaurantId_fkey")
}

model MenuItem {
  id           Int            @id @default(autoincrement())
  ProductName  String
  category     String
  description  String?
  imageUrl     String?
  isAvailable  Boolean        @default(true)
  createdAt    DateTime       @default(now())
  basePrice    Int?
  restaurantId Int
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sizes        MenuItemSize[]
  orderItems   OrderItem[] // ← add this

  @@unique([restaurantId, ProductName])
  @@index([restaurantId], map: "MenuItem_restaurantId_fkey")
}

model MenuItemSize {
  id         Int         @id @default(autoincrement())
  Size       String
  price      Int
  menuItemId Int
  orderItems OrderItem[] // ← add this
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, Size])
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  EXPIRED
  CANCELLED
}

model Order {
  id           Int         @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  status       OrderStatus @default(PENDING)
  tableNumber  Int?
  total        Int         @default(0)
  hasNewAdditions Boolean  @default(false)
  // When the order was last marked SERVED. Drives the auto-close timer:
  // a SERVED order with no new items for servedAutoCloseMinutes closes
  // itself. Cleared when new items move it back to PREPARING.
  servedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  table        Table?      @relation(fields: [tableId], references: [id])
  tableId      Int?

  @@index([restaurantId])
  @@index([status])
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productName String
  description String?

  menuItemId     Int?
  menuItem       MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  menuItemSizeId Int?
  menuItemSize   MenuItemSize? @relation(fields: [menuItemSizeId], references: [id], onDelete: SetNull)

  quantity  Int     @default(1)
  unitPrice Int
  notes     String?
  isAddition Boolean @default(false)
  // When this line was ordered. "Today" stats count by this, so items
  // added to an old order count on the day they were added.
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([menuItemId])
  @@index([createdAt])
}

model Table {
  id      Int         @id @default(autoincrement())
  qrToken String      @unique @db.VarChar(32)
  number  Int
  seats   Int
  status  TableStatus @default(AVAILABLE)

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, number])
  @@index([restaurantId])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model SubscriptionPlan {
  id            Int      @id @default(autoincrement())
  name          String
  productId     String   @unique
  price         Int
  currency      String   @default("PKR") @db.VarChar(3)
  interval      String   @default("Month")
  intervalCount Int      @default(1)
  trialDays     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id Int @id @default(autoincrement())

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  planId Int
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
  reference String? @unique
  paddleSubscriptionId  String?            @unique
  status                SubscriptionStatus @default(PENDING)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelledAt        DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([planId])
}

model Payment {
  id Int @id @default(autoincrement())

  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  paddleTransactionId  String?       @unique
  amount               Int
  currency             String        @default("PKR") @db.VarChar(3)
  status               PaymentStatus @default(PENDING)

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([subscriptionId])
  @@index([status])
}

model WebhookEvent {
  id          Int       @id @default(autoincrement())
  eventId     String    @unique
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processed])
}
