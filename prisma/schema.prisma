generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id          Int              @id @default(autoincrement())
  name        String
  email       String           @unique
  password    String
  createdAt   DateTime         @default(now())
  restaurants Restaurant[]     @relation("RestaurantOwner")
  memberships RestaurantUser[]
}

model Restaurant {
  id        Int              @id @default(autoincrement())
  name      String
  slug      String           @unique
  city      String
  address   String
  phone     String
  createdAt DateTime         @default(now())
  ownerId   Int
  owner     User             @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  users     RestaurantUser[]
  menuItems MenuItem[]
  tables    Table[]
  orders    Order[] // ← add this

  @@index([ownerId], map: "Restaurant_ownerId_fkey")
}

model RestaurantUser {
  id           Int        @id @default(autoincrement())
  userId       Int
  restaurantId Int
  isActive     Boolean    @default(true)
  role         String     @default("chef")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId], map: "RestaurantUser_restaurantId_fkey")
}

model MenuItem {
  id           Int            @id @default(autoincrement())
  ProductName  String
  category     String
  description  String?
  imageUrl     String?
  isAvailable  Boolean        @default(true)
  createdAt    DateTime       @default(now())
  basePrice    Int?
  restaurantId Int
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sizes        MenuItemSize[]
  orderItems   OrderItem[] // ← add this

  @@unique([restaurantId, ProductName])
  @@index([restaurantId], map: "MenuItem_restaurantId_fkey")
}

model MenuItemSize {
  id         Int         @id @default(autoincrement())
  Size       String
  price      Int
  menuItemId Int
  orderItems OrderItem[] // ← add this
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, Size])
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

model Order {
  id           Int         @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  status       OrderStatus @default(PENDING)
  tableNumber  Int?
  total        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  table        Table?      @relation(fields: [tableId], references: [id])
  tableId      Int?

  @@index([restaurantId])
  @@index([status])
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productName String
  description String?

  menuItemId     Int?
  menuItem       MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  menuItemSizeId Int?
  menuItemSize   MenuItemSize? @relation(fields: [menuItemSizeId], references: [id], onDelete: SetNull)

  quantity  Int     @default(1)
  unitPrice Int
  notes     String?

  @@index([orderId])
  @@index([menuItemId])
}

model Table {
  id      Int         @id @default(autoincrement())
  qrToken String      @unique @db.VarChar(32)
  number  Int
  seats   Int
  status  TableStatus @default(AVAILABLE)

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, number])
  @@index([restaurantId])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}